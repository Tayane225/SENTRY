{
  "initial_workers": 6,
  "min_workers": 2,
  "max_workers": 32,
  "adaptive_concurrency": true,
  "cpu_high_watermark": 85.0,
  "memory_high_watermark": 85.0,
  "max_hash_size": 1073741824,
  "max_content_scan_size": 33554432,
  "max_clamav_size": 104857600,
  "follow_symlinks": false,
  "one_filesystem": true,
  "include_network_drives": false,
  "include_removable_drives": true,
  "store_full_inventory": false,
  "exclude_globs": ["*/$Recycle.Bin/*", "*/System Volume Information/*", "*/node_modules/.cache/*"],
  "archive_max_depth": 3,
  "archive_max_members": 5000,
  "archive_max_total_uncompressed": 536870912,
  "archive_max_ratio": 250,
  "archive_max_member_size": 33554432,
  "approval_ttl_seconds": 1800,
  "max_failed_unlocks": 5,
  "unlock_lockout_seconds": 300,
  "clamd_address": "tcp://127.0.0.1:3310",
  "use_clamav": true,
  "use_yara": true,
  "use_defender": true,
  "defender_max_files": 25,
  "extra_yara_rule_dirs": ["C:/SecurityRules/yara"],
  "online_intel": false,
  "osv_online": false,
  "intel_cache_ttl_seconds": 86400,
  "report_min_score": 0.25,
  "monitor_interval_seconds": 10,
  "monitor_paths": [],
  "api_port": 8765
}
